###############################
# Environment Variables (.env)
#
# Usage:
# 1) Copy this file to ".env" and fill in the values (keep .env out of git, it is in .gitignore)
# 2) Local:  mvn spring-boot:run -Dspring-boot.run.profiles=local
#    Docker: docker compose up -d --build
#
# Spring reads .env directly when started from the project folder, and Docker passes it as environment
# variables. Write values without quotes: KEY=value
###############################

# Spring profile: "local" logs SQL. Empty for production.
SPRING_PROFILES_ACTIVE=

# Port the HTTP server listens on
HTTP_PORT=8080
# Factory time zone for "today" / "current month"
APP_TIME_ZONE=Europe/Moscow

# MES (PLR_* tables)
# jdbc:sqlserver://HOST:1433;databaseName=DB;encrypt=true;trustServerCertificate=true
MES_DB_URL=
MES_DB_USERNAME=
MES_DB_PASSWORD=

# TABU2 (BD_CARD), SQL Server 2012
TABU2_DB_URL=
TABU2_DB_USERNAME=
TABU2_DB_PASSWORD=

# Allowed frontend origins, comma separated (e.g. http://localhost:3000). Empty: no CORS.
CORS_ORIGIN=
